#!/usr/bin/env bash
# SPAIDER Bounty Agent launcher (same style as bin/spaider)
# Usage: spaider-bounty --scope bounty_agent/scope.json --audit --triage

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ -n "$VIRTUAL_ENV" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
    PYTHON_CMD="$VIRTUAL_ENV/bin/python"
elif [ -x "$PROJECT_ROOT/.venv/bin/python" ]; then
    PYTHON_CMD="$PROJECT_ROOT/.venv/bin/python"
else
    PYTHON_CMD="$(command -v python3)"
fi

cd "$PROJECT_ROOT"
if [ -z "${ASHNA_API_KEY:-}" ]; then
    echo "[!] ASHNA_API_KEY is not set. AI triage/drafting will be skipped."
    echo "    Get a key at https://app.ashna.ai/account?tab=api"
fi
exec "$PYTHON_CMD" -m bounty_agent.cli "$@"
